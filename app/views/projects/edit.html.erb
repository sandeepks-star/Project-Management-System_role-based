<div style="min-height: 100vh; width: 100%; background: linear-gradient(135deg, #1a1a2e, #0f3460); padding: 40px 20px; box-sizing: border-box; font-family: Arial, sans-serif;">

  <!-- Top Bar -->
  <div style="max-width: 1100px; margin: 0 auto 30px auto; display: flex; justify-content: space-between; align-items: center;">

    <h1 style="color: white; margin: 0;">✏ Edit Project</h1>

    <%= link_to "⬅ Back to Projects",
          projects_path,
          style: "background: #3498db; padding: 8px 16px; border-radius: 8px; color: white; text-decoration: none; font-weight: bold;" %>

  </div>

  <!-- Form Partial -->
  <div style="max-width: 1100px; margin: 0 auto;">
    <%= render "project", project: @project %>
  </div>

</div>