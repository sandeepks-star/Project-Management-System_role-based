<div style="min-height: 100vh; width: 100vw; background: linear-gradient(135deg, #1a1a2e, #0f3460); padding: 30px; font-family: Arial, sans-serif; box-sizing: border-box;">

  <!-- Top Section -->
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px;">

    <div>
      <h1 style="color: white; margin: 0;">Welcome, <%= current_user&.name %> 👋</h1>
      <p style="color: #cccccc; margin-top: 5px;">Manage all your projects efficiently</p>
    </div>

    <div style="display: flex; gap: 15px; align-items: center;">

      <% if current_user.manager? %>
        <%= link_to "➕ New Project", new_project_path,
          style: "background: #4CAF50; padding: 10px 18px; border-radius: 8px; color: white; text-decoration: none; font-weight: bold;" %>
      <% end %>

      <%= button_to "Logout",
            destroy_user_session_path,
            method: :delete,
            data: { confirm: "Are you sure?" },
            style: "background: #e74c3c; padding: 10px 18px; border-radius: 8px; color: white; border: none; font-weight: bold;" %>

    </div>
  </div>

  <!-- Filter Section -->
  <div style="background: rgba(255,255,255,0.1); padding: 20px; border-radius: 12px; margin-bottom: 25px; backdrop-filter: blur(10px);">
    <%= form_with(url: projects_path, method: :get, local: true) do |form| %>
      <div style="display: flex; gap: 15px; align-items: center; color: white;">

        <%= form.label :status, "Filter by Status:" %>

        <%= form.select :status,
              Project.statuses.keys.map { |key| [key.humanize, key] },
              { selected: params[:status] },
              style: "padding: 8px 12px; border-radius: 6px; border: none;" %>

        <%= form.submit "Apply",
              style: "padding: 8px 15px; background: #3498db; color: white; border: none; border-radius: 6px; cursor: pointer;" %>

      </div>
    <% end %>
  </div>

  <!-- Projects Table -->
  <div style="background: white; padding: 25px; border-radius: 15px; box-shadow: 0 10px 25px rgba(0,0,0,0.2); overflow-x: auto;">

    <h2 style="margin-top: 0;">📁 All Projects</h2>

    <table style="width: 100%; border-collapse: collapse;">

      <thead>
        <tr style="background: #2c3e50; color: white;">
          <th style="padding: 12px;">ID</th>
          <th style="padding: 12px;">Name</th>
          <th style="padding: 12px;">Start Date</th>
          <th style="padding: 12px;">End Date</th>
          <th style="padding: 12px;">Status</th>
          <th style="padding: 12px;">Actions</th>
        </tr>
      </thead>

      <tbody>

        <% if @projects.present? %>

          <% @projects.each do |project| %>
            <tr style="border-bottom: 1px solid #ddd; text-align: center;">

              <td style="padding: 10px;"><%= project.id %></td>
              <td style="padding: 10px;"><%= project.name %></td>
              <td style="padding: 10px;"><%= project.start_date %></td>
              <td style="padding: 10px;"><%= project.end_date %></td>
              <td style="padding: 10px; font-weight: bold;"><%= project.status&.humanize || "Unknown" %></td>

              <td style="padding: 10px; display: flex; justify-content: center; gap: 8px;">

                <%= link_to "Show", project_path(project),
                    style: "background: #3498db; color: white; padding: 6px 12px; border-radius: 6px; text-decoration: none;" %>

                <% if current_user.manager? %>

                  <%= link_to "Edit", edit_project_path(project),
                      style: "background: #f39c12; color: white; padding: 6px 12px; border-radius: 6px; text-decoration: none;" %>

                  <%= button_to "Delete",
                        project_path(project),
                        method: :delete,
                        data: { confirm: "Are you sure?" },
                        style: "background: #e74c3c; color: white; padding: 6px 12px; border-radius: 6px; border: none;" %>

                <% end %>

              </td>

            </tr>
          <% end %>

        <% else %>

          <tr>
            <td colspan="6" style="padding: 25px; text-align: center; font-weight: bold; color: gray;">
              🚫 No Projects Found
            </td>
          </tr>

        <% end %>

      </tbody>

    </table>
  </div>

</div>
