<div style="max-width: 700px; margin: 0 auto; background: white; padding: 40px; border-radius: 18px; box-shadow: 0 20px 45px rgba(0,0,0,0.35);">

  <!-- Error Messages -->
  <% if @task.errors.any? %>
    <div style="background: #ffe6e6; padding: 12px; border-radius: 8px; margin-bottom: 20px;">
      <% @task.errors.full_messages.each do |message| %>
        <div style="color: #cc0000; font-size: 14px;">
          <%= message %>
        </div>
      <% end %>
    </div>
  <% end %>

  <%= form_with model: [@project, @task], local: true do |form| %>

    <!-- Task Name -->
    <div style="margin-bottom: 20px;">
      <%= form.label :name, style: "font-weight: bold;" %>
      <%= form.text_field :name,
            style: "width: 100%; padding: 12px; margin-top: 6px; border-radius: 10px; border: 1px solid #ccc;" %>
    </div>

    <!-- Description -->
    <div style="margin-bottom: 20px;">
      <%= form.label :description, style: "font-weight: bold;" %>
      <%= form.text_area :description,
            rows: 4,
            style: "width: 100%; padding: 12px; margin-top: 6px; border-radius: 10px; border: 1px solid #ccc; resize: vertical;" %>
    </div>

    <!-- Priority & Status -->
    <div style="display: flex; gap: 20px; margin-bottom: 20px;">
      <div style="flex: 1;">
        <%= form.label :priority, style: "font-weight: bold;" %>
        <%= form.select :priority,
              Task.priorities.keys.map { |key| [key.humanize, key] },
              {},
              style: "width: 100%; padding: 12px; margin-top: 6px; border-radius: 10px; border: 1px solid #ccc;" %>
      </div>

      <div style="flex: 1;">
        <%= form.label :status, style: "font-weight: bold;" %>
        <%= form.select :status,
              Task.statuses.keys.map { |key| [key.humanize, key] },
              {},
              style: "width: 100%; padding: 12px; margin-top: 6px; border-radius: 10px; border: 1px solid #ccc;" %>
      </div>
    </div>

    <!-- Developers -->
    <div style="margin-bottom: 25px;">
      <%= form.label :developers, style: "font-weight: bold;" %>

      <div style="margin-top: 8px; padding: 12px; border: 1px solid #ddd; border-radius: 10px; max-height: 140px; overflow-y: auto;">
        <%= form.collection_check_boxes :developer_ids, @developers, :id, :name do |b| %>
          <div style="margin-bottom: 6px;">
            <%= b.check_box %>
            <%= b.label style: "margin-left: 6px;" %>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Submit -->
    <%= form.submit @task.persisted? ? "Update Task" : "Create Task",
          style: "width: 100%; padding: 14px; background: #4CAF50; color: white; border: none; border-radius: 12px; font-weight: bold; cursor: pointer; font-size: 15px;" %>

  <% end %>

</div>