<div style="min-height: 100vh; width: 100%; background: linear-gradient(135deg, #1a1a2e, #0f3460); padding: 40px 20px; box-sizing: border-box; font-family: Arial, sans-serif;">

  <!-- Top Bar -->
  <div style="max-width: 1100px; margin: 0 auto 30px auto; display: flex; justify-content: space-between; align-items: center;">

    <h1 style="color: white; margin: 0;">📝 Task Details</h1>

    <div style="display: flex; gap: 12px;">

      <%= link_to "⬅ Back to Project",
            project_path(@project),
            style: "background: #3498db; padding: 8px 16px; border-radius: 8px; color: white; text-decoration: none; font-weight: bold;" %>

      <% if current_user.is_a?(Manager) %>
        <%= link_to "✏ Edit Task",
              edit_project_task_path(@project, @task),
              style: "background: #f39c12; padding: 8px 16px; border-radius: 8px; color: white; text-decoration: none; font-weight: bold;" %>
      <% end %>

    </div>
  </div>

  <!-- Task Card -->
  <div style="max-width: 700px; margin: 0 auto; background: white; padding: 40px; border-radius: 18px; box-shadow: 0 20px 45px rgba(0,0,0,0.35);">

    <h2 style="margin-top: 0;"><%= @task.name %></h2>

    <!-- Description -->
    <div style="margin-bottom: 25px; color: #555;">
      <strong>Description:</strong>
      <p style="margin-top: 8px;"><%= @task.description %></p>
    </div>

    <!-- Priority & Status Row (Perfectly Aligned) -->
    <div style="display: flex; gap: 40px; margin-bottom: 25px; align-items: center;">

      <!-- Priority -->
      <div style="display: flex; align-items: center; gap: 10px;">
        <strong>Priority:</strong>
        <span style="
          padding: 6px 14px;
          border-radius: 20px;
          font-size: 13px;
          font-weight: bold;
          background:
          <%= case @task.priority
                when 'high' then '#e74c3c'
                when 'medium' then '#f39c12'
                else '#2ecc71'
              end %>;
          color: white;">
          <%= @task.priority.humanize %>
        </span>
      </div>

      <!-- Status -->
      <div style="display: flex; align-items: center; gap: 10px;">
        <strong>Status:</strong>
        <span style="
          padding: 6px 14px;
          border-radius: 20px;
          font-size: 13px;
          font-weight: bold;
          background:
          <%= case @task.status
                when 'completed' then '#2ecc71'
                when 'in_progress' then '#3498db'
                else '#95a5a6'
              end %>;
          color: white;">
          <%= @task.status.humanize %>
        </span>
      </div>

    </div>

    <hr>

    <!-- Assigned Developers -->
    <h3>👨‍💻 Assigned Developers</h3>

    <% if @task.developers.any? %>
      <ul style="padding-left: 18px;">
        <% @task.developers.each do |developer| %>
          <li style="margin-bottom: 10px;">
            <strong><%= developer.name %></strong><br>
            <span style="color: gray; font-size: 13px;"><%= developer.email %></span>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p style="color: gray;">No developers assigned to this task.</p>
    <% end %>

  </div>

</div>